# Nama dan password untuk login Keuangan (dipakai API PHP dan API Node.js).
FINANCE_USERNAME=
FINANCE_PASSWORD=

# --- Hanya untuk API Node.js (folder node-api/) ---
# Pakai API Node.js di frontend: isi `node` lalu build ulang (npm run build). Kosong = PHP.
# VITE_API_BACKEND=node

# PORT=3001
# HOST=127.0.0.1
# SESSION_SECRET=

# Database pemesanan (ticketing_db)
# BOOKINGS_DB_HOST=127.0.0.1
# BOOKINGS_DB_PORT=3306
# BOOKINGS_DB_NAME=ticketing_db
# BOOKINGS_DB_USER=root
# BOOKINGS_DB_PASSWORD=

# Database Flight Data (db-jmt)
# FLIGHTS_DB_HOST=127.0.0.1
# FLIGHTS_DB_PORT=43306
# FLIGHTS_DB_NAME=db-jmt
# FLIGHTS_DB_USER=DB-JMT
# FLIGHTS_DB_PASSWORD=

# Webhook saat status pemesanan menjadi Booked ("off" untuk menonaktifkan)
# BOOKING_WEBHOOK_URL=http://192.168.111.177:5678/webhook/booking-status
# CORS_ORIGINS=http://localhost:5173
# PDF_DIR=
