<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let real files and folders (including API endpoints) pass through unchanged.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Support direct links and refreshes on client-side pages.
  RewriteRule ^ index.html [L]
</IfModule>
